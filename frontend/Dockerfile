# syntax=docker/dockerfile:1

# ─────────────────────────────────────────────────────────────────────────────
# Vitorra frontend — production image for ECS Fargate.
# See planning/11-aws-migration-plan.md
#
# Built inside Linux on purpose: Next's standalone tracer copies only the
# BUILD platform's native binaries (sharp, swc). Building on macOS and copying
# .next in would ship darwin binaries into a Linux container.
# ─────────────────────────────────────────────────────────────────────────────

# Node 24 / npm 11 on purpose: package-lock.json is generated by npm 11 (the
# version on the team's machines), and npm 10 rejects it — `npm ci` fails with
# a spurious "out of sync" error. Keep this, the CI runner and local dev on the
# same npm MAJOR or the lockfile will churn. Verified: npm 10 fails, npm 11 OK.
ARG NODE_VERSION=24-alpine

# ── deps ─────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS deps
WORKDIR /app

# libc6-compat provides the glibc shims some native modules expect on musl.
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
# `npm ci` installs exactly the lockfile — reproducible, and it fails loudly if
# package.json and the lockfile have drifted apart.
RUN npm ci --no-audit --no-fund

# ── builder ──────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# ⚠ NEXT_PUBLIC_* values are INLINED into the client JavaScript at BUILD time.
#   They are NOT read from the container environment at runtime. A staging image
#   and a production image are therefore genuinely different images — you cannot
#   promote one to the other by changing an ECS environment variable.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT
ARG NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE
ARG NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR
ARG NEXT_PUBLIC_ONLINE_PAYMENTS
ARG NEXT_PUBLIC_ENABLE_ANALYTICS
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ARG NEXT_PUBLIC_AUTH_MODE

# Source-map upload only. Not baked into the bundle; see next.config.ts, which
# skips the upload entirely when SENTRY_AUTH_TOKEN is absent.
# NOTE: the auth token is deliberately NOT an ARG — see the build step below.
ARG SENTRY_ORG
ARG SENTRY_PROJECT

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_SENTRY_ENVIRONMENT=$NEXT_PUBLIC_SENTRY_ENVIRONMENT \
    NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=$NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE \
    NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR=$NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR \
    NEXT_PUBLIC_ONLINE_PAYMENTS=$NEXT_PUBLIC_ONLINE_PAYMENTS \
    NEXT_PUBLIC_ENABLE_ANALYTICS=$NEXT_PUBLIC_ENABLE_ANALYTICS \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY \
    NEXT_PUBLIC_AUTH_MODE=$NEXT_PUBLIC_AUTH_MODE \
    SENTRY_ORG=$SENTRY_ORG \
    SENTRY_PROJECT=$SENTRY_PROJECT \
    NEXT_TELEMETRY_DISABLED=1

# The Sentry token is mounted as a BuildKit secret rather than passed as ARG/ENV.
# An ARG is recorded in the builder stage's layer metadata and would leak to
# anyone who can read the build cache. A secret mount exists only for the
# lifetime of this one RUN and is never written to a layer.
#   Locally: docker build --secret id=sentry_auth_token,env=SENTRY_AUTH_TOKEN .
#   In CI:   same flag, with the value from GitHub secrets.
# Absent, the build still succeeds — next.config.ts simply skips the upload.
RUN --mount=type=secret,id=sentry_auth_token \
    SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token 2>/dev/null || true)" \
    npm run build

# ── runner ───────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# wget is used by the container healthcheck below; libc6-compat for sharp.
RUN apk add --no-cache libc6-compat wget

# Never run the app as root.
RUN addgroup -g 1001 -S nodejs && adduser -S -G nodejs -u 1001 nextjs

# public/ is not traced into standalone — copy it explicitly.
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
# The traced server + only the node_modules it actually reaches.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
# Hashed client assets, likewise not traced.
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000

# Container-level check. The ALB target group runs its own probe against the
# same path; this one makes `docker ps` and local runs honest too.
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health >/dev/null 2>&1 || exit 1

CMD ["node", "server.js"]
